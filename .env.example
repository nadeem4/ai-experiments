# Every hosted call in this repository goes over OpenRouter.
#   LLMs           POST /api/v1/chat/completions
#   Jev            POST /api/v1/systemone   (a decision model, not a chat model)
OPENROUTER_API_KEY=your_key       # https://openrouter.ai/keys

# Optional, and only for Jev: TypeSafe's API directly. It wins when both are
# set, because it pins the exact build rather than a dated alias.
# TYPESAFE_API_KEY=your_key

# Optional: a folder that already holds Laya's weights (model.safetensors).
# Left unset, they download on first use.
# LAYA_PATH=/path/to/laya
