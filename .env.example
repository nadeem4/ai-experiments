# Which key an experiment needs depends on which transport it was built against.

# decision_cost/ -- every hosted call, both the LLMs and Jev, goes over OpenRouter.
# The LLMs use POST /api/v1/chat/completions; Jev uses POST /api/v1/systemone.
OPENROUTER_API_KEY=your_key       # https://openrouter.ai/keys

# rerank/ -- still reaches Jev over the Vercel AI Gateway or TypeSafe directly.
# TYPESAFE_API_KEY wins when both are set, as it pins the model version.
# NOTE: the Vercel AI Gateway key was deleted on 2026-09-24. rerank/ has not been
# migrated, so it cannot reach Jev until one of these is set again.
AI_GATEWAY_API_KEY=your_key       # Vercel AI Gateway (typesafe-ai/jev)
TYPESAFE_API_KEY=your_key         # optional: TypeSafe's API directly, preferred when set

# Optional: a folder that already holds Laya's weights (model.safetensors).
# Left unset, they download into models/ on first use.
# LAYA_PATH=/path/to/laya
